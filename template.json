                                        "port": 80,
                                        "intervalInSeconds": 5,
                                        "numberOfProbes": 1,
                                        "requestPath": "/health.html"
                                    }
                                }
                            }
                        ]
                    },
                    "securityProfile": {
                        "uefiSettings": {
                            "secureBootEnabled": true,
                            "vTpmEnabled": true
                        },
                        "securityType": "TrustedLaunch"
                    }
